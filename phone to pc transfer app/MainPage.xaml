<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:phone_to_pc_transfer_app.Models"
             xmlns:discovery="clr-namespace:phone_to_pc_transfer_app.Core"
             x:Class="phone_to_pc_transfer_app.MainPage"
             x:DataType="vm:MainViewModel"
             Title="Phone-PC Transfer">

    <Grid Padding="16" RowDefinitions="Auto,*,Auto,Auto,Auto" RowSpacing="12">

        <!-- Status line -->
        <Label Grid.Row="0"
               Text="{Binding StatusMessage}"
               FontAttributes="Italic"
               LineBreakMode="TailTruncation" />

        <!-- Discovered devices -->
        <CollectionView Grid.Row="1"
                         ItemsSource="{Binding Devices}"
                         SelectionMode="Single"
                         SelectedItem="{Binding SelectedDevice}">
            <CollectionView.EmptyView>
                <Label Text="Searching for devices on your network..."
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="Gray" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="discovery:DiscoveredDevice">
                    <Grid Padding="12,10" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{Binding Name}" FontAttributes="Bold" />
                            <Label Text="{Binding Platform}" FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Text="{Binding IpAddress}"
                               FontSize="12"
                               TextColor="Gray"
                               VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Text send -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry Grid.Column="0"
                   Text="{Binding TextToSend}"
                   Placeholder="Type a message..." />
            <Button Grid.Column="1"
                    Text="Send Text"
                    Command="{Binding SendTextCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
        </Grid>

        <!-- File send -->
        <Button Grid.Row="3"
                Text="Send File..."
                Command="{Binding SendFileCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

        <!-- Busy indicator -->
        <ActivityIndicator Grid.Row="4"
                            IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}"
                            HorizontalOptions="Center" />

    </Grid>

</ContentPage>
